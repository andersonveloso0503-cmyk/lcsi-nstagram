{
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/claude", "destination": "/claude.js" },
    { "source": "/api/buffer", "destination": "/buffer.js" },
    { "source": "/api/pexels", "destination": "/pexels.js" },
    { "source": "/api/imagem", "destination": "/imagem.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
